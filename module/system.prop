# === Caventus: Pixel 6 (oriole / GS101) Memory Optimization ===

# 1. ART / dex2oat — revert 'everything' mmap bloat to profile-guided compilation
dalvik.vm.dex2oat-filter=speed-profile
dalvik.vm.image-dex2oat-filter=speed-profile
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.shared=speed
dalvik.vm.madvise.odexfile.size=33554432
dalvik.vm.madvise.vdexfile.size=33554432

# 2. LMKD — PSI-based tuning for 8 GB Pixel 6 (with Native/DroidSpaces headroom)
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
ro.lmk.psi_partial_stall_ms=50
ro.lmk.psi_complete_stall_ms=500
ro.lmk.thrashing_limit=60
ro.lmk.thrashing_limit_decay=15
ro.lmk.swap_free_low_percentage=20
ro.lmk.swap_util_max=85
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.downgrade_pressure=60
ro.lmk.debug=false

# 3. Android 16/17 mmd zRAM boot sync
mmd.zram.enabled=true
mmd.zram.size=4294967296
mmd.zram.comp_algorithm=zstd

# 4. SurfaceFlinger — Graphics RAM & latency (ram_safe)
ro.surface_flinger.clear_slots_with_set_layer_buffer=true
ro.surface_flinger.use_context_priority=true
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.running_without_sync_framework=false
